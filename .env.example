# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Host and Port (Default: 0.0.0.0:5000)
HOST=0.0.0.0
PORT=5000

# Database URI
# For local development with SQLite (uses instance/tasks.db if omitted):
# DATABASE_URL=sqlite:///instance/tasks.db

# For production with PostgreSQL or MySQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/taskdb
